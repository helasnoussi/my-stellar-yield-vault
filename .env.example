ADMIN_SECRET_KEY=
# Secret key of the account configured with the contract's set_agent function.
AGENT_SECRET_KEY=
CONTRACT_ID=CDYRFTVVJNU25W54E2H42I2YLCR3SATYLWFON6LSBFGS5GHIB4QIXSGY
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
MINIMUM_LIQUIDITY_STROOPS=5000000000
MAX_OPERATION_STROOPS=1000000000
AGENT_EXECUTE=false
AGENT_ONCE=true
AGENT_INTERVAL_MS=3600000
# Blend v2 testnet pool registered by init.js as pool id 1.
BLEND_POOL_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
# XLM kept idle in the vault for withdrawals (30 XLM), and smallest move the agent makes (1 XLM).
VAULT_IDLE_RESERVE_STROOPS=300000000
MIN_ACTION_STROOPS=10000000
# Realized yield: b_rate growth measured over this window (7 days), from Blend events
# and the agent's local history. Below the minimum history (1 h), the agent decides on the instant rate.
REALIZED_WINDOW_SECONDS=604800
REALIZED_MIN_SECONDS=3600
AGENT_STATE_FILE=.agent-state.json
# Minimum yield, in basis points per year, for a pool to receive funds.
MIN_APY_BPS=0
